# ==============================================================================
# OSS Command Center - Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.production and fill in your secure production secrets.
# Never commit the actual .env or .env.production file to version control.
# ==============================================================================

# Node runtime environment
NODE_ENV=production

# Server listening port
PORT=3100

# SQLite database path
# When running in Docker, map this to your persistent volume mount (e.g. /app/data/contributions.db)
DB_PATH=/app/data/contributions.db

# Master encryption key (AES-256-GCM)
# Required to encrypt user tokens (GitHub/GitLab personal access tokens) in SQLite.
# Generate a cryptographically secure 32-byte key:
#   openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_character_hex_string_from_openssl_rand_hex_32

# Inbound Webhook Secrets (Optional, recommended for real-time synchronization)
# Shared secret configured in your GitHub repository Webhooks settings (payload format: application/json)
GITHUB_WEBHOOK_SECRET=replace_with_github_webhook_secret

# Secret token configured in your GitLab repository Webhooks settings
GITLAB_WEBHOOK_SECRET=replace_with_gitlab_webhook_secret

# Session Secret (Optional)
# Cryptographically secure random string for signing user sessions
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace_with_random_base64_session_secret

# ==============================================================================
# Litestream S3 / Cloudflare R2 Disaster Recovery Replication (Optional)
# Continuous WAL streaming to object storage with sub-second RPO
# ==============================================================================
LITESTREAM_BUCKET=oss-command-center-backups
LITESTREAM_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=your_s3_or_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_s3_or_r2_secret_access_key
AWS_REGION=auto
