# ==============================================================================
# OSS Command Center Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=3100
NODE_ENV=development

# Cryptographic Master Key for AES-256-GCM token encryption
# Mandatory in production. Must be a high-entropy secret string (min 32 chars).
ENCRYPTION_KEY=replace_with_a_secure_random_32_byte_secret_key

# SQLite Database File Path (defaults to oss_command_center.db)
DB_PATH=oss_command_center.db

# Base URL & CORS Whitelist (comma-separated list of allowed origins)
APP_URL=http://localhost:3100
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3100

# Set to true when running behind a trusted reverse proxy (Nginx, Caddy, AWS ALB)
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# OAuth 2.0 Social Login Configuration (Optional)
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_HOST=https://gitlab.com

# ------------------------------------------------------------------------------
# Inbound Webhook Secrets (Optional fallback)
# ------------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Email Digest SMTP Configuration (Optional)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=secret_password
SMTP_FROM="OSS Command Center <notifications@example.com>"
