# Port for the Express backend server (default: 3100)
PORT=3100

# GitHub Personal Access Token (PAT) with repo/read:user scope
GITHUB_TOKEN=your_github_token_here

# User identity filters (optional CLI fallback)
GITHUB_USERNAME=your_github_username
GITLAB_USERNAME=your_gitlab_username

# GitLab Host instance
GITLAB_HOST=https://gitlab.com
